<Window x:Class="HydraWin.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HydraWin.App.Controls"
        xmlns:vm="clr-namespace:HydraWin.App.ViewModels"
        Title="HydraWin settings" Height="560" Width="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        ResizeMode="CanResize">

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="14,4" MinWidth="80" />
                <Button Content="OK" Padding="14,4" MinWidth="80" Margin="8,0,0,0"
                        IsDefault="True" Click="OnOkClick" />
            </StackPanel>
        </Border>

        <TabControl>
            <TabItem Header="General">
                <StackPanel Margin="12">
                    <CheckBox Content="Restore hidden windows when HydraWin exits"
                              IsChecked="{Binding RestoreOnExit}" Margin="0,0,0,10"
                              ToolTip="Off means windows stay hidden after HydraWin is gone; --restore-all is then the way back." />
                    <CheckBox Content="Closing the window hides it to the tray"
                              IsChecked="{Binding CloseToTray}" Margin="0,0,0,10" />
                    <CheckBox Content="Keep HydraWin above other windows"
                              IsChecked="{Binding AlwaysOnTop}" Margin="0,0,0,10"
                              ToolTip="A switch ends by raising the task's windows, which would otherwise bury this one." />
                    <CheckBox Content="Show a tray balloon when a window wants attention"
                              IsChecked="{Binding NotificationToasts}" Margin="0,0,0,10"
                              ToolTip="The badge on the task row is always shown; this adds a pop-up as well." />

                    <!--
                        The tab's first control that is not a bool. It takes effect on OK like
                        everything else here — this dialog edits copies, and a live preview would
                        make Cancel a lie.
                    -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                        <TextBlock Text="Appearance" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <ComboBox Width="170"
                                  ItemsSource="{Binding Source={x:Static
                                      vm:SettingsViewModel.AppearanceOptions}}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Appearance}"
                                  ToolTip="Follow Windows tracks the system app theme while HydraWin runs. A Windows high-contrast theme always wins.">
                            <!-- An explicit ItemTemplate rather than DisplayMemberPath: the
                                 template's face reads SelectionBoxItemTemplate, which
                                 DisplayMemberPath does not populate, so the closed combo showed
                                 the record's ToString(). -->
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Everything here is stored in state.json, which stays hand-editable." />
                </StackPanel>
            </TabItem>

            <TabItem Header="Hotkeys">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Click a box and press the combination you want. Backspace clears it — an empty box means no hotkey for that action. A combination another application already owns simply fails to register, and HydraWin says so on startup." />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Hotkeys}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding Description}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <controls:HotkeyBox Grid.Row="0" Grid.Column="1"
                                                            Padding="3,2"
                                                            Combination="{Binding Combination, Mode=TwoWay}" />

                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Foreground="{DynamicResource ErrorTextBrush}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Margin="0,2,0,0" Text="{Binding Error}"
                                                   Visibility="{Binding HasError,
                                                                        Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Notifications">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Badges normally come from the taskbar flash, which works for any application with no rule at all. These are for programs that announce something in their window title and never flash. A pattern that is not a valid regular expression is saved switched off." />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Add rule" Padding="10,3"
                                Command="{Binding AddRuleCommand}" />
                        <Button Content="Delete" Padding="10,3" Margin="8,0,0,0"
                                Command="{Binding DeleteRuleCommand}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NotificationRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                            CornerRadius="3" Padding="8" Margin="0,0,0,8"
                                            Background="Transparent"
                                            PreviewMouseLeftButtonDown="OnRuleClicked">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" Content="On"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0"
                                                          IsChecked="{Binding Enabled}" />

                                                <TextBox Grid.Column="1" Padding="3,2"
                                                         Margin="0,0,8,0"
                                                         Text="{Binding ProcessFileName,
                                                                        UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Process image name, or * for any" />

                                                <TextBlock Grid.Column="2" Text="title matches"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />

                                                <TextBox Grid.Column="3" Padding="3,2"
                                                         Text="{Binding TitleRegex,
                                                                        UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Regular expression, e.g. ^\(\d+\)" />
                                            </Grid>

                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Badge label"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBox Grid.Column="1" Padding="3,2"
                                                         Text="{Binding Label,
                                                                        UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Empty falls back to the window's own name" />
                                            </Grid>

                                            <TextBlock Margin="0,6,0,0" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Preview}" />

                                            <TextBlock Margin="0,2,0,0" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ErrorTextBrush}"
                                                       Text="{Binding Error}"
                                                       Visibility="{Binding HasError,
                                                                            Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

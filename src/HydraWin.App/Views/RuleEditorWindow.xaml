<Window x:Class="HydraWin.App.Views.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Re-attach rule" Height="440" Width="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        ResizeMode="CanResize">

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="How HydraWin recognises this window again after it — or the window — has been restarted. Handles change between runs; this rule is what puts the window back in its task." />

        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="14,4" MinWidth="80" />
                <Button x:Name="OkButton" Content="Save" Padding="14,4" MinWidth="80"
                        Margin="8,0,0,0" IsDefault="True" Click="OnSaveClick" />
            </StackPanel>
        </Border>

        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Process" VerticalAlignment="Center"
                       Margin="0,0,8,6" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Padding="3,2"
                     Text="{Binding ProcessFileName, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Image file name only, e.g. Code.exe. The full path changes when the app updates." />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Title" VerticalAlignment="Center"
                       Margin="0,0,8,6" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Padding="3,2"
                     Text="{Binding TitlePattern, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Empty matches any title of that process." />

            <CheckBox Grid.Row="2" Grid.Column="1" Content="Title is a regular expression"
                      Margin="0,0,0,6" IsChecked="{Binding TitleIsRegex}" />

            <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap"
                       Foreground="{DynamicResource ErrorTextBrush}"
                       Margin="0,0,0,6" Text="{Binding Error}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <DockPanel Margin="0,6,0,0">
            <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewCaption}" FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Preview}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                           Margin="2,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>

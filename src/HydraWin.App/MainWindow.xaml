<Window x:Class="HydraWin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HydraWin.App.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}" Height="600" Width="900"
        MinHeight="300" MinWidth="480">
    <!--
        Task 03 debug harness. Task 07 replaces this whole body with the task table, unassigned
        pane and toolbar.
    -->
    <DockPanel Margin="8">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox Content="Reconciliation sweep"
                      IsChecked="{Binding ReconciliationEnabled}"
                      VerticalAlignment="Center" />
            <Button Content="Refresh rejections"
                    Command="{Binding RefreshRejectedCommand}"
                    Margin="12,0,0,0" Padding="8,2" />
            <Button Content="Seed demo tasks"
                    Command="{Binding SeedDemoTasksCommand}"
                    Margin="12,0,0,0" Padding="8,2" />
            <Button Content="Seed switch drill"
                    Command="{Binding SeedSwitchDrillCommand}"
                    Margin="6,0,0,0" Padding="8,2" />
            <Button Content="Flush state"
                    Command="{Binding FlushStateCommand}"
                    Margin="6,0,0,0" Padding="8,2" />
            <Button Content="Clear tasks"
                    Command="{Binding ClearTasksCommand}"
                    Margin="6,0,0,0" Padding="8,2" />
            <Button Content="Hide selected (journaled)"
                    Command="{Binding HideSelectedCommand}"
                    Margin="18,0,0,0" Padding="8,2" />
            <Button Content="Restore all"
                    Command="{Binding RestoreAllWindowsCommand}"
                    Margin="6,0,0,0" Padding="8,2" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Switch to:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <!-- CommandParameter must be typed: a bare "1" is a string and RelayCommand&lt;int&gt; rejects it. -->
            <Button Content="1" Command="{Binding SwitchToOrderCommand}"
                    Padding="10,2" Margin="0,0,4,0">
                <Button.CommandParameter><sys:Int32>1</sys:Int32></Button.CommandParameter>
            </Button>
            <Button Content="2" Command="{Binding SwitchToOrderCommand}"
                    Padding="10,2" Margin="0,0,4,0">
                <Button.CommandParameter><sys:Int32>2</sys:Int32></Button.CommandParameter>
            </Button>
            <Button Content="3" Command="{Binding SwitchToOrderCommand}"
                    Padding="10,2" Margin="0,0,4,0">
                <Button.CommandParameter><sys:Int32>3</sys:Int32></Button.CommandParameter>
            </Button>
            <Button Content="4" Command="{Binding SwitchToOrderCommand}"
                    Padding="10,2" Margin="0,0,12,0">
                <Button.CommandParameter><sys:Int32>4</sys:Int32></Button.CommandParameter>
            </Button>
            <Button Content="Delete active task"
                    Command="{Binding DeleteActiveTaskCommand}" Padding="8,2" Margin="0,0,12,0" />
            <CheckBox Content="Crash after journal flush"
                      IsChecked="{Binding CrashAfterJournalFlush}"
                      VerticalAlignment="Center" Foreground="#B00000" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="{Binding Status}" Opacity="0.75" />
            <TextBlock Text="{Binding RejectionSummary}" Opacity="0.75" />
            <TextBlock Text="{Binding RecoveryNotice}" FontWeight="Bold" Foreground="#B35C00" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Height="150" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Tasks (task 04)" FontWeight="Bold"
                       Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding TaskLines}" FontFamily="Consolas" FontSize="11"
                     VirtualizingStackPanel.IsVirtualizing="False" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Tracked" FontWeight="Bold"
                           Margin="0,0,0,4" />
                <!-- Virtualization off so the whole inventory is readable for verification. -->
                <ListBox ItemsSource="{Binding Windows}"
                         SelectedItem="{Binding SelectedWindow}"
                         VirtualizingStackPanel.IsVirtualizing="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ProcessFileName}" Opacity="0.6"
                                           FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Rejected (and why)" FontWeight="Bold"
                           Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding Rejected}"
                         DisplayMemberPath="Display" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

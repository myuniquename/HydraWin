<Window x:Class="HydraWin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HydraWin.App"
        xmlns:vm="clr-namespace:HydraWin.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}" Height="600" Width="900"
        Icon="pack://application:,,,/Assets/hydrawin.ico"
        MinHeight="300" MinWidth="640"
        Topmost="{Binding AlwaysOnTop}"
        AllowDrop="True" PreviewDragOver="OnWindowDragOver"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <local:HexToBrushConverter x:Key="HexToBrush" />
        <local:CountToVisibilityConverter x:Key="CountToVisibility" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- BoolToVisibility and StringToVisibility come from App.xaml: more than one window
             needs them now. -->


        <!--
            One window row, shared by the task list and the unassigned pane. Tagged so the
            drag-and-drop code can find it in the visual tree without named-element plumbing.

            The context menus use Click handlers rather than command bindings on purpose: a
            ContextMenu sits in its own visual tree, so a RelativeSource walk to this Window
            never reaches it. The handlers also let the menu adapt to the row on opening.
        -->
        <DataTemplate x:Key="WindowRow" DataType="{x:Type vm:WindowViewModel}">
            <Border Tag="WindowRow" Background="Transparent" Padding="4,3" CornerRadius="3"
                    Margin="0,1">
                <Border.ContextMenu>
                    <ContextMenu Opened="OnWindowMenuOpened">
                        <MenuItem Header="_Focus" Click="OnFocusWindowClick" />
                        <Separator />
                        <MenuItem Header="_Unassign" Tag="Unassign" Click="OnUnassignWindowClick" />
                        <MenuItem Header="_Move to" Tag="MoveTo" />
                        <Separator />
                        <MenuItem Header="_Edit re-attach rule…" Tag="EditRule"
                                  Click="OnEditRuleClick" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The app icon, over a generic dot for processes that have none. -->
                    <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                          Margin="0,0,6,0">
                        <Ellipse Width="8" Height="8" Fill="#9AA5B1" />
                        <Image Source="{Binding Icon}" />
                    </Grid>

                    <!-- The live Claude Code marker; animates for free as title events arrive. -->
                    <TextBlock Grid.Column="1" Text="{Binding ActivityGlyph}" FontSize="12"
                               Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#4C8DFF"
                               Visibility="{Binding ActivityGlyph,
                                                    Converter={StaticResource StringToVisibility}}" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding ProcessName}" Opacity="0.55" FontSize="10" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Waiting for attention: the dot clears when the window is focused. -->
                        <Ellipse Width="8" Height="8" Fill="#E5484D" Margin="4,0,0,0"
                                 VerticalAlignment="Center"
                                 ToolTip="{Binding NotificationLabel}"
                                 Visibility="{Binding NotificationLabel,
                                                      Converter={StaticResource StringToVisibility}}" />
                        <Border Background="#E6E9EC" CornerRadius="2" Padding="4,0" Margin="4,0,0,0"
                                Visibility="{Binding IsHydraWinHidden,
                                                     Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="hidden" FontSize="10" Opacity="0.7" />
                        </Border>
                        <Border Background="#FFE2C2" CornerRadius="2" Padding="4,0" Margin="4,0,0,0"
                                ToolTip="Windows refused to hide this one, so it stays on screen through every switch. Usually a protected process, or one that became elevated after HydraWin first saw it."
                                Visibility="{Binding IsUnmanageable,
                                                     Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="won't hide" FontSize="10" Opacity="0.8" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One task row: header, then its windows when expanded. -->
        <DataTemplate x:Key="TaskRow" DataType="{x:Type vm:TaskViewModel}">
            <Border Tag="TaskRow" Margin="0,0,0,4" CornerRadius="4" Padding="0,0,0,2">
                <!--
                    Every visual default belongs in the style, not on the element: a local value
                    outranks a style trigger in WPF, so setting Background here would silently
                    beat the IsActive trigger and the active task would never look active.
                -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="#E1E5EA" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="BorderBrush" Value="#4C8DFF" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Background" Value="#F2F7FF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.ContextMenu>
                    <ContextMenu Opened="OnTaskMenuOpened">
                        <MenuItem Header="_Switch to this task" Click="OnSwitchToTaskClick" />
                        <Separator />
                        <MenuItem Header="_Rename" Click="OnRenameTaskClick" />
                        <MenuItem Header="_Delete" Click="OnDeleteTaskClick" />
                    </ContextMenu>
                </Border.ContextMenu>

                <StackPanel>
                    <Grid Margin="0,4,6,4" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Rectangle Grid.Column="0" Width="4" Height="20" RadiusX="2" RadiusY="2"
                                   Margin="4,0,8,0"
                                   Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />

                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsExpanded}"
                                      Width="16" Height="16" Margin="0,0,6,0" Padding="0"
                                      BorderThickness="0" Background="Transparent"
                                      Focusable="False" ToolTip="Show or hide this task's windows">
                            <TextBlock FontSize="9" VerticalAlignment="Center"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="▶" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Text" Value="▼" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToggleButton>

                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Background="Transparent"
                                   MouseLeftButtonDown="OnTaskNameClick"
                                   ToolTip="Click to switch to this task; double-click to rename"
                                   Visibility="{Binding IsRenaming,
                                                        Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- AllowDrop=False on purpose: a TextBox handles DragOver and Drop itself
                             for text, which would swallow a window dropped on this row. -->
                        <TextBox Grid.Column="2" AllowDrop="False"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" Padding="2,0"
                                 IsVisibleChanged="OnRenameBoxVisibleChanged"
                                 Loaded="OnRenameBoxReady"
                                 KeyDown="OnRenameBoxKeyDown" LostFocus="OnRenameBoxLostFocus"
                                 Visibility="{Binding IsRenaming,
                                                      Converter={StaticResource BoolToVisibility}}" />

                        <!-- In-progress rollup: visible even when the task is collapsed (§ F). -->
                        <TextBlock Grid.Column="3" Text="{Binding ActivityGlyph}" FontSize="13"
                                   Foreground="#4C8DFF" VerticalAlignment="Center" Margin="6,0"
                                   ToolTip="A session in this task is working"
                                   Visibility="{Binding ActivityGlyph,
                                                        Converter={StaticResource StringToVisibility}}" />

                        <!-- Clicking the badge jumps to the newest waiting window, so it handles
                             its own press rather than falling through to the row's switch. -->
                        <Border Grid.Column="4" Tag="Badge" Background="#E5484D" CornerRadius="8"
                                MinWidth="16" Height="16" Margin="0,0,6,0" Cursor="Hand"
                                ToolTip="{Binding NotificationTooltip}"
                                PreviewMouseLeftButtonDown="OnBadgeClick"
                                Visibility="{Binding NotificationCount,
                                                     Converter={StaticResource CountToVisibility}}">
                            <TextBlock Text="{Binding NotificationCount}" Foreground="White"
                                       FontSize="10" FontWeight="Bold" Margin="4,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Centering aligns the text *box*, and Segoe UI reserves more
                                     room above the baseline than digits use, so a box-centred
                                     digit renders 1px low. Nudge the ink, not the layout: a
                                     margin would be halved by the centring and would disturb the
                                     pill width that Margin="4,0" sets for two-digit counts.
                                     Measured for FontSize 10 in a 16px badge. -->
                                <TextBlock.RenderTransform>
                                    <TranslateTransform Y="-1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>

                        <TextBlock Grid.Column="5" VerticalAlignment="Center" Opacity="0.55"
                                   FontSize="11"
                                   Text="{Binding WindowCount, StringFormat={}{0} win}" />

                        <!-- The Spy++ target. Tagged so the row's own mouse handling leaves it
                             alone: pressing it must start neither a switch nor a row drag. -->
                        <Border Grid.Column="6" Tag="Picker" Background="Transparent"
                                Cursor="Cross" Margin="10,0,0,0" Padding="3"
                                PreviewMouseLeftButtonDown="OnPickerMouseDown"
                                ToolTip="Drag this onto any window on screen to put it in this task">
                            <Grid Width="18" Height="18">
                                <Ellipse Width="16" Height="16" Stroke="#4C8DFF" StrokeThickness="2" />
                                <Line X1="9" Y1="0" X2="9" Y2="18" Stroke="#4C8DFF" StrokeThickness="2" />
                                <Line X1="0" Y1="9" X2="18" Y2="9" Stroke="#4C8DFF" StrokeThickness="2" />
                                <Ellipse Width="4" Height="4" Fill="#4C8DFF"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Windows}"
                                  ItemTemplate="{StaticResource WindowRow}"
                                  Margin="22,0,4,2"
                                  Visibility="{Binding IsExpanded,
                                                       Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel x:Name="RootPanel">
        <Border DockPanel.Dock="Top" Padding="8,6" Background="#F7F8FA"
                BorderBrush="#E1E5EA" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ New task" Command="{Binding CreateTaskCommand}" Padding="10,3" />
                <Button Content="Show all" Command="{Binding ShowAllCommand}" Padding="10,3"
                        Margin="8,0,0,0"
                        ToolTip="Bring every hidden window back and leave no task active" />
                <CheckBox Content="Stay on top" IsChecked="{Binding AlwaysOnTop}"
                          VerticalAlignment="Center" Margin="16,0,0,0"
                          ToolTip="Keep HydraWin above other windows, so a switch does not bury it" />
                <Button Content="Settings…" Padding="10,3" Margin="16,0,0,0"
                        Click="OnSettingsClick"
                        ToolTip="Hotkeys, notification rules and general behaviour" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="8,5" Background="#F7F8FA"
                BorderBrush="#E1E5EA" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="TASKS" FontSize="10" FontWeight="Bold"
                           Opacity="0.5" Margin="2,0,0,6" />

                <!-- The whole pane is the drop surface, so a task dragged past the last row still
                     lands somewhere sensible. -->
                <Border x:Name="TaskPane" Background="Transparent" AllowDrop="True"
                        PreviewMouseLeftButtonDown="OnPaneMouseDown"
                        PreviewMouseMove="OnPaneMouseMove"
                        PreviewMouseLeftButtonUp="OnTaskPaneMouseUp"
                        DragOver="OnTaskPaneDragOver" DragLeave="OnDragLeave"
                        Drop="OnTaskPaneDrop">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <TextBlock Opacity="0.45" Margin="4,12" TextWrapping="Wrap"
                                       Text="No tasks yet. Press “+ New task”, then drag windows in from the right.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl x:Name="TaskList" ItemsSource="{Binding Tasks}"
                                          ItemTemplate="{StaticResource TaskRow}" />
                        </Grid>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="UNASSIGNED WINDOWS" FontSize="10"
                           FontWeight="Bold" Opacity="0.5" Margin="2,0,0,6" />
                <TextBlock DockPanel.Dock="Bottom" Margin="2,6,0,0" FontSize="10" Opacity="0.45"
                           TextWrapping="Wrap"
                           Text="These stay visible in every task. Drag one onto a task row to assign it." />

                <Border x:Name="UnassignedPane" Background="Transparent" AllowDrop="True"
                        PreviewMouseLeftButtonDown="OnPaneMouseDown"
                        PreviewMouseMove="OnPaneMouseMove"
                        DragOver="OnUnassignedDragOver" DragLeave="OnDragLeave"
                        Drop="OnUnassignedDrop">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Unassigned}"
                                      ItemTemplate="{StaticResource WindowRow}" />
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

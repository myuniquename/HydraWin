<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Context menus: the two row menus in MainWindow, and the tray menu that TrayIcon builds in
        code.

        These styles reach the tray menu even though it is created in C# and lives in its own popup
        visual tree. Resource lookup walks the element's own Resources, then the parent chain, and
        when that chain runs out it falls back to Application.Current.Resources. A ContextMenu's
        PopupRoot truncates the *parent walk* — which is why a RelativeSource binding to the Window
        fails from a context menu, as MainWindow.xaml already notes — but it does not remove the
        application fallback. So: every theme resource must live in Application.Resources and never
        in Window.Resources. A style put in MainWindow.Resources would not reach the ContextMenus
        declared inside its own DataTemplates.

        Two traps, both of which look like "it just didn't work":

          - MenuItem's default style picks a template by Role, and there are four. A context menu
            uses SubmenuItem for ordinary items and SubmenuHeader for one that opens a submenu.
            MainWindow's "Move to" is a SubmenuHeader, so styling only SubmenuItem leaves exactly
            that one item light.

          - Separators inside a menu do not use the plain Separator style. WPF re-keys them to
            MenuItem.SeparatorStyleKey, so a style with that key is required as well. The tray menu
            has four separators and the row menus have three.

        And one functional point: the check gutter is not decoration. TrayIcon sets IsCheckable and
        IsChecked on "Close to tray", so a template that drops the gutter silently removes a working
        checkmark.
    -->

    <!-- ============================================================ ContextMenu -->

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="0,3" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border CornerRadius="4" BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource MenuBackgroundBrush}"
                            BorderBrush="{DynamicResource MenuBorderBrush}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ menu separator -->

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <!-- Indented past the check gutter, so it lines up with the item text. -->
                    <Rectangle Height="1" Margin="26,0,8,0" SnapsToDevicePixels="True"
                               Fill="{DynamicResource MenuSeparatorBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ MenuItem -->

    <!-- An ordinary item: check gutter, header, and room for an input-gesture hint. -->
    <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="{x:Type MenuItem}">
        <Border x:Name="Chrome" Background="Transparent" Margin="3,0" CornerRadius="3"
                SnapsToDevicePixels="True">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The gutter is functional: "Close to tray" in the tray menu is IsCheckable. -->
                <Path x:Name="Check" Grid.Column="0" Visibility="Collapsed"
                      Width="10" Height="8" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 0,4 L 3.2,7.2 L 9,1" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{DynamicResource AccentBrush}" />

                <ContentPresenter x:Name="Header" Grid.Column="1" Margin="0,0,12,0"
                                  ContentSource="Header" VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />

                <TextBlock Grid.Column="2" Margin="0,0,4,0" VerticalAlignment="Center"
                           Text="{TemplateBinding InputGestureText}"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Chrome" Property="Background"
                        Value="{DynamicResource MenuItemHoverBackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        An item that opens a submenu. MainWindow's window-row menu has one ("Move to"), and it is
        the single most likely thing to be left unstyled, because it looks like an ordinary item and
        is not one as far as MenuItem is concerned.
    -->
    <ControlTemplate x:Key="SubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
        <Border x:Name="Chrome" Background="Transparent" Margin="3,0" CornerRadius="3"
                SnapsToDevicePixels="True">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter Grid.Column="1" Margin="0,0,12,0" ContentSource="Header"
                                  VerticalAlignment="Center" RecognizesAccessKey="True" />

                <Path Grid.Column="2" Margin="0,0,6,0" Width="4" Height="8" Stretch="Uniform"
                      VerticalAlignment="Center" Data="M 0,0 L 4,4 L 0,8"
                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{DynamicResource TextSecondaryBrush}" />

                <Popup x:Name="PART_Popup" Placement="Right" Focusable="False"
                       AllowsTransparency="True" PopupAnimation="Fade"
                       IsOpen="{TemplateBinding IsSubmenuOpen}">
                    <Border Margin="2,0,0,0" CornerRadius="4" BorderThickness="1" Padding="0,3"
                            Background="{DynamicResource MenuBackgroundBrush}"
                            BorderBrush="{DynamicResource MenuBorderBrush}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Chrome" Property="Background"
                        Value="{DynamicResource MenuItemHoverBackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}" />
        <Style.Triggers>
            <!-- Only the two submenu roles can occur here: HydraWin has no menu bar, so
                 TopLevelItem and TopLevelHeader never appear. -->
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource SubmenuHeaderTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

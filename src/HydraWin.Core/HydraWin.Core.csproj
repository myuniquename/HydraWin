<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>HydraWin.Core</RootNamespace>
    <!--
      Required by [LibraryImport] source-generated marshalling, which every Interop/ file uses.
      Scoped to Core: it is the only project allowed to declare P/Invoke.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Core is UI-free on purpose: no WPF reference, so its logic stays unit-testable.
    It takes no runtime NuGet dependencies - System.Text.Json is in-box.
  -->

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.32.0.713">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
